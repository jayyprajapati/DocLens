# Copy this to `backend.env` on the server and fill in REAL production values, then lock it down:
#   cp backend.env.example backend.env && chmod 600 backend.env
# `backend.env` is gitignored — never commit real secrets.

# --- Runtime ---------------------------------------------------------------
ENV=production

# --- Brain (the RAG engine) ------------------------------------------------
# Reached in-cluster over the shared networks as host "brain-backend" (no public hop). BRAIN_API_KEY
# MUST match the value set in Brain's brain.env.
BRAIN_BASE_URL=http://brain-backend:8000
BRAIN_API_KEY=REPLACE_ME
BRAIN_APP_NAME=doclens

# --- MongoDB (self-hosted in the shared infra stack) -----------------------
# Mongo runs ONCE in /srv/infra, reached over the `data` network as host "mongo". DocLens has its own
# database `doclens` + user `doclens` (created during onboarding — see DEPLOYMENT.md). authSource is
# the db the user was created in (here, `doclens`).
MONGO_URI=mongodb://doclens:REPLACE_ME@mongo:27017/doclens?authSource=doclens
MONGO_DB=doclens

# --- Security (REQUIRED in production) -------------------------------------
# Signs anonymous browser sessions. Without it production refuses every request. Generate once
# with `openssl rand -hex 32` and keep it stable (rotating it signs every visitor out).
SESSION_SECRET=REPLACE_ME
# Shared token for the Admin panel → DocLens internal API (/internal/admin/*). Must equal
# DOCLENS_ADMIN_TOKEN in /srv/admin/backend.env. `openssl rand -hex 32`. Unset = internal API off.
ADMIN_API_TOKEN=REPLACE_ME

# --- Free mode ("hosted") -----------------------------------------------------
# Your own Ollama Cloud key, used only when free mode is switched on in Admin → DocLens → Settings
# (model, quotas and the on/off switch all live there, not here). Never shown to anyone.
HOSTED_OLLAMA_API_KEY=

# --- CORS ------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://doclens.jayprajapati.dev

# --- Upload sandbox hard ceilings (optional; protect the shared server) -------
# EXTRACT_CONCURRENCY=1        # parser processes at once (box memory is tight)
# EXTRACT_TIMEOUT_S=90         # wall-clock + CPU seconds per file
# EXTRACT_MEM_MB=512           # address-space cap per parser process
# HARD_MAX_PAGES=500           # Admin can set the page limit up to this
# HARD_MAX_CHARS=2000000
# EVENTS_RETENTION_DAYS=180    # analytics log TTL

# --- Accuracy / guardrail tuning ---------------------------------------------
# These now only SEED the defaults: the live values are edited in Admin → DocLens → Settings
# (stored in Mongo, applied within ~10 s). Defaults are eval-calibrated, see EVALS.md.
# Re-run `python evals/run_eval.py` and `evals/compare.py` before changing any of these in production.
# ANSWER_VERIFY=auto            # auto = second-opinion check only when risk signals fire; always = strictest, ~+1.5 s; off
# EVIDENCE_GATE_SCORE=-9.5      # best rerank score below this => "not found" with no LLM call
# CONTEXT_MAX_CHUNKS=6          # chunks shown to the model (per query, after margin selection)
# CONTEXT_SCORE_MARGIN=7.0      # keep chunks within this many rerank points of the best
# ANSWER_TEMPERATURE=0.1
# ANSWER_REASONING=             # off|low|medium|high for Ollama reasoning models (blank = provider default)
# CHAT_RATE_PER_MIN=30          # per user, in-process
# UPLOAD_RATE_PER_10MIN=30
# MAX_UPLOAD_MB=25
# DEBUG_TRACE=                  # leave unset in production (puts raw model output in response meta)
